# Slack Bot Token (starts with xoxb-)
# Get this from: api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# Your personal Slack user ID (not your handle — the ID like U0123456789)
# Find it: Slack → click your name → View full profile → three-dot menu → Copy member ID
SLACK_MY_USER_ID=U0123456789

# Anthropic API key for brief generation
# Get this from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Active company profile filename (without path) — swap when switching clients
COMPANY_PROFILE_FILE=company_profile_crhh.txt
